{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BitScribe Steward",
  "version": "1.5.0",
  "identifier": "com.bitscribe.steward",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BitScribe Steward",
        "width": 1024,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": [
          11,
          13,
          19,
          255
        ],
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}