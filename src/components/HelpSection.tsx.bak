const TutorialAccordion = ({ title, icon: Icon, colorClass, bgClass, isOpen, onToggle, children, id, isHighlighted }: any) => {
  return (
    <div id={id} className={`py-2 px-3 bg-[#14171F] border rounded-xl shadow-md transition-all duration-300 ${isHighlighted ? 'border-blue-500 shadow-blue-500/20 scale-[1.01]' : 'border-[#1e232e]'}`}>
      <div 
        className="flex items-center justify-between cursor-pointer select-none"
        onClick={onToggle}
      >
        <div className="flex items-center gap-3">
          <div className={`p-1.5 w-fit rounded-lg ${bgClass} ${colorClass}`}>
            <Icon className="w-4 h-4" />
