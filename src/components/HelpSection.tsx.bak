              <a href="https://github.com/eligrey/FileSaver.js" target="_blank" rel="noopener noreferrer" className="hover:underline text-blue-400 font-semibold">
                file-saver
              </a>
            </li>
            <li>
              <a href="https://expressjs.com" target="_blank" rel="noopener noreferrer" className="hover:underline text-blue-400 font-semibold">
                Express
              </a>
            </li>
            <li>
              <a href="https://www.typescriptlang.org" target="_blank" rel="noopener noreferrer" className="hover:underline text-blue-400 font-semibold">
                TypeScript
              </a>
            </li>
            <li>
              <a href="https://v2.tauri.app" target="_blank" rel="noopener noreferrer" className="hover:underline text-blue-400 font-semibold">
                Tauri V2
              </a>
            </li>
          </ul>
        </div>
      </div>



      {/* Human-AI Collaboration & Support Section */}
      <div id="support-section" className={`py-4 px-5 bg-gradient-to-br from-[#1b172a] to-[#14171F] border rounded-xl shadow-2xl space-y-4 transition-all duration-300 ${isTourActive && tourStepIndex === 34 ? 'border-purple-400 shadow-[0_0_40px_rgba(168,85,247,0.5)] relative z-[60] scale-[1.02]' : 'border-purple-500/30'}`}>
        <h3 className="text-xs font-bold text-purple-400 flex items-center gap-2 uppercase tracking-wide">
          <Layers className="w-4 h-4 text-purple-400" />
          The Story Behind BitScribe: Human-AI Collaboration
        </h3>
        
        <div className="grid grid-cols-1 md:grid-cols-5 gap-6 items-center">
          <div className="md:col-span-3 space-y-3 text-slate-300">
            <p className="text-xs leading-relaxed font-sans">
              BitScribe Digital Media Library Steward (DMLS) is not just a software tool—it is the direct product of a close, highly iterative creative partnership between a <strong>Human Curator</strong> (Visionary) and an <strong>AI Software Architect</strong>.
            </p>
            <p className="text-xs text-slate-400 leading-relaxed font-sans">
              Together, we have invested well over <strong className="text-emerald-400 font-semibold">200 combined hours</strong> of dedication across 11 consecutive versions—from a tiny experimental command line script (v0.1) into this production-grade, highly-optimized full-stack management dashboard. 
            </p>
            <p className="text-xs text-slate-400 leading-relaxed font-sans">
              The human half of the team provided a comprehensive vision, direction, usability standards, extensive technical experience and hours of hands-on testing and refining of both functionality and user experience. The AI half of the team built complex analytics engines, database integrations and responsive UI components. BitScribe represents a beautiful milestone in how humans and AI can cooperate to rapidly engineer solutions neither could have done alone.
            </p>
            <div className="pt-2 text-xs text-slate-300 font-sans font-semibold">
              🎁 Support the Project
            </div>
            <p className="text-[11px] text-slate-400 leading-relaxed font-sans">
              If BitScribe has saved you hours of manually checking formats or searching for duplicates, please consider tipping or making a small donation! Your support directly sustains ongoing maintenance, database hosting research, and the release of new features.
            </p>
          </div>

          <div className="md:col-span-2 flex flex-col items-center justify-center p-4 bg-[#0d0e12] border border-slate-800/80 rounded-xl space-y-3">
            <span className="text-[10px] font-bold uppercase tracking-wider text-slate-400">Scan to Donate (PayPal)</span>
            
            {/* PayPal QR Code Image Asset */}
            <div className="relative group p-2 bg-white rounded-lg shadow-lg hover:shadow-purple-500/10 transition-all flex items-center justify-center">
              <img 
                src={projectMark} 
                alt="Project QR" 
                className="w-36 h-36 object-contain"
                referrerPolicy="no-referrer"
              />
            </div>
            
            <a 
              href="https://www.paypal.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              className="px-4 py-1.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-[11px] font-bold flex items-center gap-1.5 shadow transition-all cursor-pointer"
            >
              <span>Donate via PayPal</span>
              <svg className="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" strokeLinecap="round" strokeLinejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  );
};

export default function HelpSection({ highlightId, isTourActive, tourStepIndex }: HelpSectionProps) {
  const [openPanels, setOpenPanels] = useState<Record<string, boolean>>({});
  const [isHistoryExpanded, setIsHistoryExpanded] = useState(false);

  useEffect(() => {
    if (highlightId) {
      // Map legacy/backwards-compatible IDs correctly
      let targetId = highlightId;
      if (highlightId === 'help-custom-rules') {
        targetId = 'help-discovery'; // fallback to Discovery Mode tutorial
      }
      setOpenPanels(prev => ({ 
        ...prev, 
        [targetId]: true, 
        'help-custom-rules': true,
        'help-streaming': true 
      }));
      setTimeout(() => {
        const el = document.getElementById(targetId);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }, 150);
    }
  }, [highlightId]);

  const togglePanel = (id: string) => {
    setOpenPanels(prev => ({ ...prev, [id]: !prev[id] }));
  };

  return (
    <div className="space-y-4 animate-fadeIn" id="help-tab-panel">
      
      {/* Header Bar */}
      <div className="py-2.5 px-4 bg-[#14171F] border border-[#1e232e] rounded-xl shadow-2xl" id="help-header-bar">
        <h2 className="text-sm font-bold text-slate-100 flex items-center gap-2">
          <BookOpen className="w-4 h-4 text-blue-500 font-bold" />
          {APP_NAME} Help Center & Learn Docs
        </h2>
        <p className="text-xs text-slate-400 mt-1 leading-relaxed">
          Step-by-step tutorials and FAQ's for the key features of {APP_NAME}.
        </p>
      </div>

      {/* Restructured Dual-Column Layout: Tutorials & Frequently Asked Questions */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4" id="help-layout-grid">
        
        {/* Left Column: Tutorials */}
        <div className="space-y-4" id="help-tutorials-column">
          <div className="py-2.5 px-4 bg-[#14171F] border border-[#1e232e] rounded-xl shadow-md">
            <h3 className="text-xs font-bold text-slate-100 flex items-center gap-2 uppercase tracking-wide">
              <BookOpen className="w-4 h-4 text-emerald-400 font-bold" />
              Step-by-Step Tutorials
            </h3>
            <p className="text-[11px] text-slate-400 mt-1 leading-relaxed font-sans">
              Interactive guides to help you master the key library scanning features and quality audits.
            </p>
          </div>

          <TutorialAccordion 
              id="help-discovery"
              title="1. Media Discovery" 
              icon={Settings} 
              colorClass="text-blue-400" 
              bgClass="bg-blue-500/10"
              isOpen={openPanels['help-discovery']}
              onToggle={() => togglePanel('help-discovery')}
              isHighlighted={highlightId === 'help-discovery'}
            >
              <div className="mb-2 px-2.5 py-2 rounded bg-slate-500/5 border border-slate-800/30">
                <span className="text-[9px] uppercase font-bold text-slate-400 tracking-wider">What it does</span>
                <p className="mt-0.5 text-slate-300 leading-normal">
                  Scans your entire media library into the database. This is the essential starting point for everyone to fully catalog their movies, TV shows, and music. It also allows power users to analyze the library in several key ways.
                </p>
              </div>
              <div className="mt-2"><strong>How to Catalog your Inventory:</strong></div>
              <ol className="list-decimal list-inside space-y-1 pl-1">
                <li>Enable <strong className="text-blue-400">Media Discovery</strong> inside the <strong className="text-white">Options</strong> tab to bypass standard direct-play checks.</li>
                <li>Use the specialized presets: <strong className="text-white">Video Only</strong>, <strong className="text-white">Music Only</strong>, or <strong className="text-white">Corruption Scan</strong>.</li>
                <li>Manually query and check the lists of accepted video codecs, audio surround channels, and containers.</li>
                <li>Items that use rare/unrecognized codecs are logged as "Discovery Skip/Unresolved" so you can review them.</li>
              </ol>
            </TutorialAccordion>

            <TutorialAccordion 
              id="help-streaming"
              title="2. Stream Audit Scan" 
              icon={Layers} 
              colorClass="text-emerald-400" 
              bgClass="bg-emerald-500/10"
              isOpen={openPanels['help-streaming'] || openPanels['help-custom-rules']}
              onToggle={() => togglePanel('help-streaming')}
              isHighlighted={highlightId === 'help-streaming' || highlightId === 'help-custom-rules'}
            >
              <div className="mb-2 px-2.5 py-2 rounded bg-slate-500/5 border border-slate-800/30">
                <span className="text-[9px] uppercase font-bold text-slate-400 tracking-wider">What it does</span>
                <p className="mt-0.5 text-slate-300 leading-normal">
                  Evaluates media files against standard playback constraints. Intended to identify files that require transcoding for seamless playback on modern network streamers or legacy devices.
                </p>
              </div>
              <div className="mt-2"><strong>How to Optimize Compatibility & Minimize Transcode Risks:</strong></div>
              <ol className="list-decimal list-inside space-y-1.5 pl-1">
                <li>Open the <strong className="text-white">Options</strong> tab and check <strong className="text-emerald-400">Stream Audit Scan</strong>.</li>
                <li>Toggle standard presets: <strong className="text-white">Modern Standards (2015+ HW)</strong> (suited for standard post-2015 consumer hardware supporting HEVC & EAC3 natively), <strong className="text-white">Legacy Standards</strong> (ideal for old/mobile client players), or <strong className="text-rose-400">Bleeding Edge</strong> (flagging lossless audio formats or rare codecs like Opus/AV1 carrying high transcoding and buffering risks).</li>
                <li>Tune accepted video codecs (e.g. HEVC, H264) and select surround codecs (e.g. AC3, EAC3).</li>
                <li><strong>Note:</strong> <strong className="text-white">DTS</strong> has been removed from the default Modern Standard surround audio codecs because major TV manufacturers (like LG and Samsung) dropped support for it, often triggering server-side transcoding. You can manually enable it in the Options tab if your playback devices natively support DTS.</li>
                <li>Run a scan; the dashboard calculates the overall **Direct Play Rate** with streamlined, highly scannable analysis reasons.</li>
              </ol>
            </TutorialAccordion>

            <TutorialAccordion 
              id="help-subtitle-scan"
              title="3. Subtitle Audit" 
              icon={Subtitles} 
              colorClass="text-purple-400" 
              bgClass="bg-purple-500/10"
              isOpen={openPanels['help-subtitle-scan']}
              onToggle={() => togglePanel('help-subtitle-scan')}
              isHighlighted={highlightId === 'help-subtitle-scan'}
            >
              <div className="mb-2 px-2.5 py-2 rounded bg-slate-500/5 border border-slate-800/30">
                <span className="text-[9px] uppercase font-bold text-slate-400 tracking-wider">What it does</span>
                <p className="mt-0.5 text-slate-300 leading-normal">
                  Identifies which files have missing subtitles AND classifies subtitle formats (such as SRT, PGS, or VOB) for files that do have them. This data is critical for evaluating streaming compatibility, as certain image-based subtitle formats can force high-CPU server transcoding.
                </p>
              </div>
              <div className="mt-2"><strong>How to Audit Subtitles:</strong></div>
              <ol className="list-decimal list-inside space-y-1 pl-1">
                <li>Check the <strong className="text-purple-400">Subtitle Audit</strong> checkbox on the Options page.</li>
                <li>The system analyzes your files for internal subtitle tracks and queries adjacent companion paths for <strong className="text-white">.srt</strong> companion files.</li>
                <li>The Dashboard displays a dedicated **Subtitle Audit** metrics bar and highlights files with missing subtitles.</li>
                <li>Highlights assets lacking subtitle coverage to ensure accessibility and streaming compatibility.</li>
              </ol>
            </TutorialAccordion>

            <TutorialAccordion 
              id="help-duplication-scan"
              title="4. Media Duplication Audit" 
              icon={Layers} 
              colorClass="text-orange-400" 
              bgClass="bg-orange-500/10"
              isOpen={openPanels['help-duplication-scan']}
              onToggle={() => togglePanel('help-duplication-scan')}
              isHighlighted={highlightId === 'help-duplication-scan'}
            >
              <div className="mb-2 px-2.5 py-2 rounded bg-slate-500/5 border border-slate-800/30">
                <span className="text-[9px] uppercase font-bold text-slate-400 tracking-wider">What it does</span>
                <p className="mt-0.5 text-slate-300 leading-normal">
                  Identifies redundant media assets. Intended for users wishing to quickly locate and deduplicate extra copies of the same file (e.g., 1080p and 4K variants of the same movie) to free up storage space.
                </p>
              </div>
              <div className="mt-2"><strong>How to Audit Duplicates & Clean Space:</strong></div>
              <ol className="list-decimal list-inside space-y-1 pl-1">
                <li>Toggle the general duplication check or select separate <strong className="text-white">Video</strong> or <strong className="text-white">Music</strong> toggles.</li>
                <li><strong>Video check:</strong> Normalizes release tags and directories. Groups files matching within a <strong className="text-white">3-minute duration window</strong>.</li>
                <li><strong>Music check:</strong> Matches track titles & artists, cross-checking metadata constraints with a <strong className="text-white">30-second duration gate</strong>.</li>
                <li>Check the anomalies log to safely locate storage redundancies and keep lossless copies over low-bitrate MP3s.</li>
              </ol>
            </TutorialAccordion>

            <TutorialAccordion 
              id="help-anomaly-scan"
              title="5. Quality Audit" 
              icon={AlertCircle} 
              colorClass="text-rose-400" 
              bgClass="bg-rose-500/10"
              isOpen={openPanels['help-anomaly-scan']}
              onToggle={() => togglePanel('help-anomaly-scan')}
              isHighlighted={highlightId === 'help-anomaly-scan'}
            >
              <div className="mb-2 px-2.5 py-2 rounded bg-slate-500/5 border border-slate-800/30">
                <span className="text-[9px] uppercase font-bold text-slate-400 tracking-wider">What it does</span>
                <p className="mt-0.5 text-slate-300 leading-normal">
                  Performs an advanced bitrate-to-resolution ratio scan to detect bloated or starved files (e.g. ultra-low bitrate 1080p or excessively bloated 4K files). This audit flags efficiency anomalies to optimize storage usage and ensure optimal streaming performance.
                </p>
              </div>
              <div className="mt-2"><strong>How to Identify Bloat & Starvation:</strong></div>
              <ol className="list-decimal list-inside space-y-1 pl-1">
                <li>Turn on <strong className="text-rose-400">Quality Audit</strong> inside your Options interface.</li>
                <li><strong>Bloated Files:</strong> Highlights media files consuming extreme bitrates (e.g. 1080p transcodes exceeding 30 Mbps).</li>
                <li><strong>Starved Files:</strong> Pins down pixelated, overly compressed video streams below acceptable benchmarks (e.g. 1080p under 1.5 Mbps).</li>
                <li>Under-bitrate FLAC/audio lists are evaluated under 160 kbps thresholds, helping you target files to upgrade.</li>
              </ol>
            </TutorialAccordion>

            <TutorialAccordion
              id="help-metadata-scan"
              title="6. Metadata Completeness Audit"
              icon={Info}
              colorClass="text-teal-400"
              bgClass="bg-teal-500/10"
              isOpen={openPanels['help-metadata-scan']}
              onToggle={() => togglePanel('help-metadata-scan')}
              isHighlighted={highlightId === 'help-metadata-scan'}
            >
              <div className="mb-2 px-2.5 py-2 rounded bg-slate-500/5 border border-slate-800/30">
                <span className="text-[9px] uppercase font-bold text-slate-400 tracking-wider">What it does</span>
                <p className="mt-0.5 text-slate-300 leading-normal">
                  Evaluates comprehensive metadata including codecs, resolution, channel counts, and parsed season/episode data.
                </p>
              </div>
              <div className="mt-2"><strong>How to Validate Metadata & Compare Cleaned Titles:</strong></div>
              <ol className="list-decimal list-inside space-y-1 pl-1">
                <li>Check the <strong className="text-teal-400">Metadata Audit</strong> checkbox on the Options page.</li>
                <li>Select Video Metadata, Music Metadata, or both.</li>
                <li>The system reads embedded container tags (like ID3 for MP3, MKV/MP4 tags) to identify missing details (Title, Director, Artist, Year).</li>
                <li>Review the missing tags chart under the main dashboard and export reports to find untagged tracks or untitled videos.</li>
                <li><strong>Cleaned Title Comparison:</strong> For videos, Excel exports now feature a side-by-side comparison between the raw embedded tag title and our cleaned, parsed title, highlighting tag junk or truncation clearly.</li>
              </ol>
            </TutorialAccordion>

            <TutorialAccordion
              id="help-folder-structure"
              title="7. Recommended Folder Structure"
              icon={Folder}
              colorClass="text-amber-400"
              bgClass="bg-amber-500/10"
              isOpen={openPanels['help-folder-structure']}
              onToggle={() => togglePanel('help-folder-structure')}
              isHighlighted={highlightId === 'help-folder-structure'}
            >
              <div className="mb-2 px-2.5 py-2 rounded bg-slate-500/5 border border-slate-800/30">
                <span className="text-[9px] uppercase font-bold text-slate-400 tracking-wider">Dynamic Layout Organization</span>
                <p className="mt-0.5 text-slate-300 leading-normal font-sans">
                  BitScribe parses paths dynamically based on root and parent folder names. We directly support the following top-level organizational folders: <span className="text-amber-400 font-semibold">Movies, TV Shows, Series, Documentaries, DocuSeries, Anime, Cartoons, Shorts, Foreign, Extras, Music, Audio, Soundtracks, and Music Compilations</span>.
                </p>
              </div>
              <div className="mt-2 text-slate-300 font-semibold mb-1">Recommended Library Blueprint:</div>
              <div className="p-2.5 bg-[#0a0c10] border border-[#1e232e] rounded-lg font-mono text-[10px] text-emerald-400 leading-tight space-y-1 overflow-x-auto whitespace-pre">
{`📂 MediaRoot/
├── 📂 Movies/
│   └── 📂 Inception (2010)/
│       ├── Inception (2010) - 1080p.mkv
│       ├── Inception.en.srt (Companion subtitle)
│       └── poster.jpg (Artwork / Poster)
├── 📂 TV Shows/
│   └── 📂 Breaking Bad/
│       ├── 📂 Season 01/
│       │   ├── Breaking Bad - S01E01 - Pilot.mkv
│       │   └── Breaking Bad - S01E02.mkv
│       └── 📂 Extras/
│           └── Behind the Scenes.mp4
├── 📂 DocuSeries/
│   └── 📂 Planet Earth II/
│       └── 📂 Season 1/
│           └── Planet Earth II - S01E01.mkv
├── 📂 Foreign/          <-- Fully compatible as Movies / Video
│   └── 📂 Seven Samurai (1954)/
│       └── Seven Samurai (1954).mkv
└── 📂 Music/
    └── 📂 Pink Floyd/
        └── 📂 The Dark Side of the Moon/
            ├── 01 - Speak to Me.flac
            └── 02 - Breathe.flac`}
              </div>
              <div className="mt-3 space-y-2 text-slate-400 text-[11px] font-sans">
                <div>
                  <strong className="text-slate-200">📌 TV Shows & DocuSeries:</strong> For episodes to group perfectly, we recommend nesting files inside a subfolder matching <code className="text-blue-400 font-mono">Season 01</code>, <code className="text-blue-400 font-mono">Season 1</code>, <code className="text-blue-400 font-mono">S01</code>, or similar. The system is extremely resilient to spaces, lack of spaces (e.g., <code className="text-blue-400 font-mono">Season1</code>), dashes, and dots!
                </div>
                <div>
                  <strong className="text-slate-200">📌 Unknown Folder Structures:</strong> If your media is not organized using the top-level folders listed above, BitScribe will attempt to detect TV Shows by parsing filenames for standard season and episode markers (e.g. S01E01). If no episodic markers are found, the file will default to being categorized as a Movie.
                </div>
                <div>
                  <strong className="text-slate-200">📌 Top-Level "Foreign" Folders:</strong> Top-level folders named <code className="text-amber-400 font-mono">Foreign</code> are recognized perfectly! You can keep them at the top level or, for even cleaner grouping, nest them inside <code className="text-amber-300 font-mono">Movies/Foreign</code> as desired.
                </div>
                <div>
                  <strong className="text-slate-200">📌 Extras Folders:</strong> Place behind-the-scenes content or companion files under paths containing keywords like <code className="text-purple-400 font-mono">extras</code>, <code className="text-purple-400 font-mono">specials</code>, or <code className="text-purple-400 font-mono">deleted scenes</code> to have them automatically parsed and classified as "Extras" with their unique layout reports.
                </div>
              </div>
            </TutorialAccordion>

            <TutorialAccordion
              id="help-streaming-standards"
              title="8. Streaming Standards Explained"
              icon={BookOpen}
              colorClass="text-pink-400"
              bgClass="bg-pink-500/10"
              isOpen={openPanels['help-streaming-standards']}
              onToggle={() => togglePanel('help-streaming-standards')}
              isHighlighted={highlightId === 'help-streaming-standards'}
            >
              <div className="mb-2 px-2.5 py-2 rounded bg-slate-500/5 border border-slate-800/30">
                <span className="text-[9px] uppercase font-bold text-slate-400 tracking-wider">Why we chose these standards</span>
                <p className="mt-0.5 text-slate-300 leading-normal font-sans">
                  The goal of the different tiers (Modern, Legacy, and Bleeding Edge) is to maximize your ability to stream without transcoding on as many devices as possible. Forced transcoding can cause buffering and stress your server.
                </p>
              </div>
              <ul className="list-disc list-inside space-y-2 pl-1 mt-2 text-[11px] text-slate-300 font-sans leading-relaxed">
                <li><strong className="text-white">Modern Standards (2015+):</strong> This tier focuses on formats that are widely supported by most modern smart TVs, streaming sticks, and mobile devices (e.g., HEVC, H.264, AAC, AC3). It strikes the best balance of high quality, efficient compression, and broad compatibility.</li>
                <li><strong className="text-white">Legacy Standards:</strong> This targets older or budget hardware (pre-2015) that might struggle with newer high-efficiency codecs. H.264 for video and AAC/AC3 for audio are the safest bets here.</li>
                <li><strong className="text-white">Bleeding Edge:</strong> Formats like AV1 video or lossless TrueHD/DTS-HD audio offer incredible quality or compression, but they are often not natively supported by standard consumer devices, resulting in forced server-side transcoding.</li>
                <li><strong className="text-white">Why DTS is not in Modern by default:</strong> While popular among home theater enthusiasts, major television manufacturers (like LG and Samsung) have dropped native support for DTS in many recent models. Keeping it out of the default Modern tier helps avoid unexpected transcoding, but you can always enable it in Options if your setup supports it!</li>
              </ul>
            </TutorialAccordion>



        </div>

        {/* Right Column: Frequently Asked Questions (FAQ) */}
        <div className="space-y-4" id="help-faqs-column">
          <div className="py-2.5 px-4 bg-[#14171F] border border-[#1e232e] rounded-xl shadow-md">
            <h3 className="text-xs font-bold text-slate-100 flex items-center gap-2 uppercase tracking-wide">
              <HelpCircle className="w-4 h-4 text-blue-400 font-bold" />
              Frequently Asked Questions
            </h3>
            <p className="text-[11px] text-slate-400 mt-1 leading-relaxed font-sans">
              Detailed technical explanations regarding media codecs, nested folder structures, and specials.
            </p>
          </div>

          <FaqItem question="What is BitScribe Steward?">
            <p>
              <strong>BitScribe Digital Media Library Steward (DMLS)</strong> is a powerful discovery tool that seamlessly catalogs your movies, TV shows, music, and documentaries.
            </p>
            <p className="mt-1.5">
              Once scanned, it provides actionable insights to refine your library—helping you identify missing assets like subtitles, pinpoint low-quality or bloated files, and uncover hidden duplicates you didn't even know you had.
            </p>
          </FaqItem>

          <FaqItem question="How does Video vs Music Duplication reporting differ?">
              <p>
                <strong>Video Duplication</strong> strips release keywords/years and matches films within a 3-minute playtime limit.
              </p>
              <p className="mt-1">
                <strong>Music Duplication</strong> parses ID3 Metadata (Title + Artist) and checks file lengths within a tighter 30-second window, flagging duplicates and favoring FLAC and 320Kbps MP3 files for music. MP3s with bitrates lower than 320Kbps will be flagged.
              </p>
            </FaqItem>

            <FaqItem question="What makes a video file &quot;Streaming Unfriendly&quot;?">
              Files are flagged as unfriendly if they use mismatched codecs, old codecs that aren't designed for streaming (like DivX or Xvid), unoptimized containers (like AVI), or potentially the newest "bleeding edge" codecs that are not yet well supported in consumer hardware. These issues force your media server to transcode the video on the fly, which can cause playback buffering and high server CPU usage.
            </FaqItem>

            <FaqItem question="Can I organize my movies into alphabetical or nested subfolders?">
              <strong>Yes, absolutely!</strong> BitScribe scans all directory levels in your file path. As long as some parent folder contains a matching category keyword (like <code className="text-amber-400 font-mono text-[10px]">Movies</code>, <code className="text-amber-400 font-mono text-[10px]">Films</code>, etc., even if it is nested like <code className="text-blue-400 font-mono text-[10px]">movies/a/MovieTitle/MovieName.mkv</code>), it is automatically identified as a movie. Nested folder hierarchies of any depth are fully supported!
            </FaqItem>

            <FaqItem question="What happens if an &quot;Extras&quot; folder is inside a &quot;Season&quot; folder?">
              <strong>The scanner parses this flawlessly!</strong> When a folder path matches "Extras" (or specials, bonus features, deleted scenes, behind-the-scenes, etc.), BitScribe recursively climbs the folder tree to skip any season folders (e.g. <code className="text-blue-400 font-mono text-[10px]">Season 01</code>), correctly identifying the parent TV Show or DocuSeries title as the main group name.
            </FaqItem>

            <FaqItem question="What folder names does BitScribe recognize natively, and what happens otherwise?">
              <p>BitScribe matches folder names using flexible keyword checks (case-insensitive):</p>
              <ul className="list-disc list-inside space-y-0.5 mt-1 text-slate-300">
                <li><strong className="text-amber-400">Movies:</strong> Movies, Movie, Films, Film, Cinema, Cinemas, UHD, Foreign</li>
                <li><strong className="text-amber-400">TV Shows:</strong> TV Shows, TV Show, TV, Series, Shows, Cartoons, Anime</li>
                <li><strong className="text-amber-400">DocuSeries:</strong> DocuSeries, Documentary Series, Documentary Show</li>
                <li><strong className="text-amber-400">Documentaries:</strong> Documentaries, Documentary, Docs, Doc</li>
                <li><strong className="text-amber-400">Shorts:</strong> Shorts, Short films, Short film, Shortfilms</li>
                <li><strong className="text-amber-400">Concerts:</strong> Concerts, Concert, Live Shows, Live Show, Live Performances, Live Performance</li>
                <li><strong className="text-amber-400">Music:</strong> Music, Audio, Soundtracks, Compilations</li>
              </ul>
              <p className="mt-1.5">
                If a folder path doesn't contain any recognizable keyword, files default to <strong className="text-slate-300">Other</strong>, unless the filename has explicit TV formats (like `S01E01`) or Years (like `(1999)`), which enables smart auto-classification fallback.
              </p>
            </FaqItem>

            <FaqItem question="I have a top-level library folder called &quot;Specials&quot;. How will BitScribe handle this?">
              <p>
                <strong>BitScribe handles this beautifully!</strong> Many media managers use a dedicated top-level folder called <code className="text-amber-400 font-mono text-[10px]">Specials</code> for seasonal gems or holiday one-offs (like <em>Rudolph the Red-Nosed Reindeer (1964)</em>). 
              </p>
              <p className="mt-1.5">
                - <strong>Smart Detection:</strong> When <code className="text-blue-400 font-mono text-[10px]">Specials</code> is scanned as a top-level parent folder, BitScribe bypasses the generic "Extras" tag and groups these files under a standalone <strong>Specials</strong> category rather than mixing them into Movies or TV Shows.
              </p>
              <p className="mt-1.5">
                - <strong>Nesting Extras:</strong> Behind-the-scenes "Extras" subfolders placed <em>inside</em> individual show or movie folders (e.g., <code className="text-purple-400 font-mono text-[10px]">TV Shows/Breaking Bad/Specials/</code>) are still correctly identified as native companion Extras!
              </p>
            </FaqItem>

            <FaqItem question="What does the 'Discovery Skip / Unresolved' count refer to?">
              In Discovery Mode, items using rare, unknown codecs, or files utilizing codecs unchecked in your current Settings column lists are skipped rather than indexed so the library steward can review them for catalog safety.
            </FaqItem>

            <FaqItem question="Can I customize individual transcode alert thresholds?">
              Yes. All video codecs lists, surround patterns, and stereo audio profiles can be edited inside the Library Stewardship Options menu under the Options page tab. The evaluator updates diagnostic outputs instantly.
            </FaqItem>

            <FaqItem question="What is the 'Cleaned Title' comparison column in the Metadata Audit report?">
              <p>
                The <strong>Cleaned Title</strong> comparison column is a powerful new addition to our Video Metadata Excel reports. It places the raw, embedded metadata title tag side-by-side with the cleaned, parsed title generated by BitScribe's filename cleanup engine. 
              </p>
              <p className="mt-1.5">
                This helps you easily spot files with mismatched, truncated, or junk-filled tags (like titles with release group names or resolution tags baked in) so you can fix them to ensure your media servers index them beautifully.
              </p>
            </FaqItem>

            <FaqItem question="What does the '2015+ HW' cutoff in Stream Audits mean?">
              Around the year <strong>2015</strong>, consumer streaming hardware (such as Roku, Apple TV, Nvidia Shield, and standard Smart TVs) universally adopted native hardware-accelerated decoding for modern, high-efficiency formats—specifically <strong>HEVC/H.265</strong> video and <strong>EAC3</strong> (Dolby Digital Plus) surround audio. Analyzing your library against this profile tells you if your assets are perfectly optimized for modern Direct Play without requiring any server overhead.
            </FaqItem>

            <FaqItem question="Why are 'Bleeding Edge' files flagged as a transcoding or buffering risk?">
              <p>
                <strong>Bleeding Edge</strong> streams utilize lossless, extremely high-fidelity audio (such as TrueHD, DTS-HD MA, or multichannel FLAC) or highly modern but uncommon video formats (like AV1). 
              </p>
              <p className="mt-1.5">
                While these formats are incredible for local high-end home theaters, they are not supported by the vast majority of standard consumer streaming sticks, remote mobile devices, or web browsers. When streamed, your server is forced to transcode these massive lossless audio streams on the fly, triggering high server CPU usage, playback buffering spinners, and potential subtitle synchronization failures.
              </p>
            </FaqItem>

            <FaqItem question="How does the Library Scan Details table display audio tracks?">
              To keep the user interface incredibly clean and scannable, we have implemented a <strong>Smart Audio Display</strong>. The grid combines the audio codec name and its exact channel count into a single highly dense column layout (for example, displaying as <code className="text-blue-400 font-mono">AAC (2ch)</code> or <code className="text-blue-400 font-mono">EAC3 (6ch)</code>) so you can inspect your streams at a glance without horizontal scroll fatigue.
            </FaqItem>

            <FaqItem question="What are some examples of hardware supported at each streaming level?">
              <p className="mb-2">
                Here are examples of consumer hardware and the streaming playback levels they comfortably support natively without triggering server transcodes:
              </p>
              <div className="space-y-3 mt-2">
                <div>
                  <strong className="text-slate-200">Legacy Standards (Broad Compatibility)</strong>
                  <ul className="list-disc list-inside text-slate-400 mt-1 space-y-0.5 pl-1">
                    <li>Apple TV (3rd Generation & older)</li>
                    <li>Chromecast (1st & 2nd Gen)</li>
                    <li>Older Smart TVs (Pre-2015 WebOS / Tizen)</li>
                    <li>Standard Web Browsers (Chrome, Firefox, Edge)</li>
                    <li>PlayStation 4 / Xbox One (Base models)</li>
                  </ul>
                </div>
                <div>
                  <strong className="text-white">Modern Standards (2015+ HW)</strong>
                  <ul className="list-disc list-inside text-slate-300 mt-1 space-y-0.5 pl-1">
                    <li>Apple TV 4K (1st Gen & newer)</li>
                    <li>Nvidia Shield TV (Base Models)</li>
                    <li>Roku Ultra & Streaming Stick 4K</li>
                    <li>Chromecast with Google TV (4K)</li>
                    <li>Amazon Fire TV Stick 4K Max</li>
                    <li>Modern Smart TVs (2015+ LG OLEDs, Sony Bravia, Samsung)</li>
                  </ul>
                </div>
                <div>
                  <strong className="text-rose-400">Bleeding Edge (High-End Lossless / AV1)</strong>
                  <ul className="list-disc list-inside text-slate-300 mt-1 space-y-0.5 pl-1">
                    <li>Nvidia Shield TV Pro (Full TrueHD/DTS-HD MA passthrough)</li>
                    <li>Custom Home Theater PCs (HTPCs)</li>
                    <li>Premium AVRs (Audio/Video Receivers) with eARC passthrough</li>
                    <li>Latest gen dedicated Media Players (Zidoo, Dune HD)</li>
                    <li>Flagship TVs featuring native AV1 hardware decoders (2022+)</li>
                  </ul>
                </div>
              </div>
            </FaqItem>
          </div>

        </div>





      </div>

      {/* About Box */}
      <div className="py-3 px-4 bg-[#14171F] border border-[#1e232e] rounded-xl shadow-2xl space-y-4">
        <h3 className="text-xs font-bold text-[#a855f7] flex items-center gap-2 uppercase tracking-wide">
          <Info className="w-4 h-4" />
          About Application Profile
        </h3>
        
        <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-b border-slate-800 py-4 text-xs font-sans">
          <div>
            <div className="text-slate-500 text-[10px] uppercase font-bold tracking-wider">App Name</div>
            <div className="text-slate-200 font-semibold mt-1">{APP_NAME}</div>
          </div>
          <div>
            <div className="text-slate-500 text-[10px] uppercase font-bold tracking-wider">Release Version</div>
            <div className="text-slate-200 font-bold font-mono mt-1 text-blue-400">{APP_VERSION}</div>
          </div>
          <div>
            <div className="text-slate-500 text-[10px] uppercase font-bold tracking-wider">Publication Date</div>
            <div className="text-slate-200 font-semibold mt-1 flex items-center gap-1.5">
              <Calendar className="w-3.5 h-3.5 text-slate-400" />
              {APP_VERSION_DATE}
            </div>
          </div>
        </div>

        <div className="space-y-2 border-b border-slate-800/40 pb-3">
          <div 
            className="flex items-center justify-between cursor-pointer select-none py-1 group"
            onClick={() => setIsHistoryExpanded(!isHistoryExpanded)}
          >
            <h4 className="text-xs font-bold text-slate-200 group-hover:text-white transition-colors">Feature Release History:</h4>
            <div className="text-slate-500 group-hover:text-slate-300 transition-colors">
              {isHistoryExpanded ? <ChevronDown className="w-4 h-4" /> : <ChevronRight className="w-4 h-4" />}
            </div>
          </div>
          <div className={`overflow-hidden transition-all duration-300 ${isHistoryExpanded ? 'max-h-[1400px] opacity-100 mt-2' : 'max-h-0 opacity-0'}`}>
            <ul className="space-y-1.5 text-[11px] text-slate-400 leading-relaxed font-sans list-disc list-inside pl-1">
              <li><strong className="text-slate-300">v0.1</strong>: The genesis version! Began as a humble PowerShell script leveraging ffprobe to identify "Plex friendly" media, featuring a rudimentary UI and simple Excel reporting.</li>
              <li><strong className="text-slate-300">v0.2 - v0.7</strong>: Established early graphical foundations using Tkinter, progressively unlocking deeper ffprobe analysis capabilities and refining the user interface with each iteration.</li>
              <li><strong className="text-slate-300">v0.8</strong>: Side-by-side configurations layout, iOS-style rounded corners similar to mobile sheets, simplified layperson step tutorials, and full audio codecs distribution parsing.</li>
              <li><strong className="text-slate-300">v0.9</strong>: Dashboard UX improvements, removal of classic menu bar, chart limit removal, unified path entries.</li>
              <li><strong className="text-slate-300">v0.99</strong>: Refined UI component rendering, discovery mode expansion, streaming compatibility bugfixes.</li>
              <li><strong className="text-slate-300">v1.0 Beta 1</strong>: Integrated portable local SQLite database with on-the-fly server synchronization, established foundation for companion/partner apps ecosystem, added configurable Excel column preset registry, and added the Media Duplication Scan.</li>
              <li><strong className="text-slate-300">v1.1 Beta 1</strong>: Combined Video and Music metadata completeness scans under a unified options panel; renamed "Quality Anomaly Detection" to "Quality Audit" in header views; added space-saving, high-efficiency Start, Pause, Stop sidebar actions; and enabled distinct prompts warned confirmation for local Cache clear and server DB flushing.</li>
              <li><strong className="text-slate-300">v1.1 Beta 2</strong>: Extracted exact dimensional properties into resolution fields (e.g., 1080p to 1920x1080), separated Bleeding Edge analysis with specialized visual indicators and Excel color highlighting, and improved the folder category parsing precision (e.g. DocuSeries paths).</li>
              <li><strong className="text-slate-300">v1.1 Beta 3</strong>: Standardized empty/disabled status indicators across scan panels, synchronized tutorial ordering with rule menus, refined library steward terminology for a wider audience, added "Export All" functionality for simultaneous report generation, and clarified "Streaming Unfriendly" terminology and video codecs parameters.</li>
              <li><strong className="text-slate-300">v1.1 RC1 - RC2</strong>: Added dynamic system log viewer and log exporter. Compacted dashboard typography. Simplified terminology and added comprehensive hover tooltips to maximize accessibility.</li>
              <li><strong className="text-slate-300">v1.1 (Release)</strong>: Fully graduated production release! Added multi-state memory closing logic to Troubleshooting and Log panels, polished tutorial layouts with friendly layperson-friendly definitions, established a permanent AI-Human Collaboration tribute, added vector-drawn secure payment donations utility, and promoted the entire codebase to standard production v1.1.</li>
              <li><strong className="text-slate-300">v1.2RC1</strong>: Replaced iframe-blocking alert confirmation with a modern React state-driven verification system. Corrected dashboard metrics to robustly display custom music files. Expanded demo data generation with balanced healthy and problematic MP3 tracks. Enhanced product tour sequence covering all scan configurator modes with robust auto-scrolling container positioning.</li>
              <li><strong className="text-slate-300">v1.2 (Release)</strong>: Fully graduated production release! Configured standalone portable desktop packaging (for Windows, macOS, and Linux) utilizing a local SQLite database relative to the executable directory. Upgraded Subtitle and Quality Audit interfaces to identify specific subtitle formats (SRT, PGS, VOB) and analyze efficiency anomalies concurrently, and included Tauri in the open-source library roster.</li>
              <li><strong className="text-slate-300">v1.3 (Release)</strong>: Migrated backend application runtime from Electron to Tauri V2 with robust Rust bindings, improved cross-platform packaging, enhanced ffprobe sidecar stability, and established a scalable, modern security model.</li>
              <li><strong className="text-slate-300">v1.4 Beta</strong>: Restored full-stack backend scanning environment, resolved category mapping bugs for Docuseries/Documentary Series to ensure title properties map fully across all UI elements and export layouts (Excel, HTML, CSV), and established strict pipeline verification standards.</li>
            </ul>
          </div>
        </div>

        <div id="oss-section" className={`space-y-2 p-3 rounded-xl transition-all duration-300 ${isTourActive && tourStepIndex === 33 ? 'bg-indigo-900/30 border border-indigo-500 shadow-[0_0_30px_rgba(99,102,241,0.4)] relative z-[60] scale-[1.01]' : ''}`}>
          <h4 className="text-xs font-bold text-slate-200">Open Source Acknowledgements:</h4>
