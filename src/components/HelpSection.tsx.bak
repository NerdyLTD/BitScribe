                better-sqlite3
              </a>
            </li>
            <li>
              <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" className="hover:underline text-blue-400 font-semibold">
                Tailwind CSS
              </a>
            </li>
            <li>
              <a href="https://github.com/eugeneware/ffprobe-static" target="_blank" rel="noopener noreferrer" className="hover:underline text-blue-400 font-semibold">
                ffprobe-static
              </a>
            </li>
            <li>
              <a href="https://github.com/exceljs/exceljs" target="_blank" rel="noopener noreferrer" className="hover:underline text-blue-400 font-semibold">
                exceljs
              </a>
              
            </li>
            <li>
              <a href="https://recharts.org" target="_blank" rel="noopener noreferrer" className="hover:underline text-blue-400 font-semibold">
                Recharts
              </a>
            </li>
            <li>
              <a href="https://lucide.dev" target="_blank" rel="noopener noreferrer" className="hover:underline text-blue-400 font-semibold">
