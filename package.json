{
  "name": "bitscribe-suite",
  "version": "1.5.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=apps/rx",
    "dev:steward": "npm run dev --workspace=apps/steward",
    "dev:rx": "npm run dev --workspace=apps/rx",
    "lint": "npm run lint --workspaces --if-present",
    "tauri": "npm run tauri --workspace=apps/steward"
  },
  "dependencies": {
    "@ffprobe-installer/darwin-arm64": "^5.0.1",
    "adm-zip": "^0.6.0",
    "express": "^5.2.1",
    "puppeteer": "^25.5.0"
  },
  "overrides": {
    "exceljs": {
      "archiver": "^8.0.0",
      "fast-csv": "^5.0.7",
      "unzipper": "^0.12.5"
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
